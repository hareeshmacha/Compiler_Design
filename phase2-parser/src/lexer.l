%option noyywrap
%option yylineno
%option nounput
%option noinput

%{
#include <iostream>
#include <string>
#include <vector>
#include "semantic_types.hpp"
#include "symbol_table.hpp"
#include "parser.tab.hpp" // Generated by Bison
#include "error_handler.hpp"

extern std::vector<ParsedToken*> all_tokens;

static ParsedToken* makeToken(const std::string& lexeme, const std::string& default_type) {
    ParsedToken* tok = new ParsedToken(lexeme, default_type, yylineno);
    all_tokens.push_back(tok);
    return tok;
}

// Variables for multi-line literal tracking
static std::string strbuf;
static int tokStartLine;
static bool litHadError;
static int charCount;
%}

DIGIT       [0-9]
LETTER      [a-zA-Z_]
ID          {LETTER}({LETTER}|{DIGIT})*
HEXDIGIT    [0-9a-fA-F]
OCTDIGIT    [0-7]
BINDIGIT    [01]

LSUF        (l|L)
LLSUF       (ll|LL)
USUF        (u|U)
INT_SUFFIX  ({USUF}({LLSUF}|{LSUF})?|({LLSUF}|{LSUF}){USUF}?)
FRAC        ({DIGIT}+\.{DIGIT}*|\.{DIGIT}+)

%x STRSTATE
%x CHRSTATE
%x COMMENTSTATE

%%

"/*"                             { tokStartLine = yylineno; BEGIN(COMMENTSTATE); }
<COMMENTSTATE>"*/"               { BEGIN(INITIAL); }
<COMMENTSTATE>\n                 { }
<COMMENTSTATE><<EOF>>            { reportError(tokStartLine, "/*", "Unterminated block comment"); BEGIN(INITIAL); yyterminate(); }
<COMMENTSTATE>.                  { }

"//"[^\n]*                       { }

[ \t\r\n]+                       { }

"int"        { yylval.token_ptr = makeToken(yytext, "INT"); return INT; }
"char"       { yylval.token_ptr = makeToken(yytext, "CHAR"); return CHAR; }
"float"      { yylval.token_ptr = makeToken(yytext, "FLOAT"); return FLOAT; }
"double"     { yylval.token_ptr = makeToken(yytext, "DOUBLE"); return DOUBLE; }
"void"       { yylval.token_ptr = makeToken(yytext, "VOID"); return VOID; }
"short"      { yylval.token_ptr = makeToken(yytext, "SHORT"); return SHORT; }
"long"       { yylval.token_ptr = makeToken(yytext, "LONG"); return LONG; }
"signed"     { yylval.token_ptr = makeToken(yytext, "SIGNED"); return SIGNED; }
"unsigned"   { yylval.token_ptr = makeToken(yytext, "UNSIGNED"); return UNSIGNED; }
"struct"     { yylval.token_ptr = makeToken(yytext, "STRUCT"); return STRUCT; }
"enum"       { yylval.token_ptr = makeToken(yytext, "ENUM"); return ENUM; }
"union"      { yylval.token_ptr = makeToken(yytext, "UNION"); return UNION; }
"class"      { yylval.token_ptr = makeToken(yytext, "CLASS"); return CLASS; }
"public"     { yylval.token_ptr = makeToken(yytext, "PUBLIC"); return PUBLIC; }
"private"    { yylval.token_ptr = makeToken(yytext, "PRIVATE"); return PRIVATE; }
"protected"  { yylval.token_ptr = makeToken(yytext, "PROTECTED"); return PROTECTED; }
"this"       { yylval.token_ptr = makeToken(yytext, "THIS"); return THIS; }
"static"     { yylval.token_ptr = makeToken(yytext, "STATIC"); return STATIC; }
"typedef"    { yylval.token_ptr = makeToken(yytext, "TYPEDEF"); return TYPEDEF; }
"auto"       { yylval.token_ptr = makeToken(yytext, "AUTO"); return AUTO; }
"const"      { yylval.token_ptr = makeToken(yytext, "CONST"); return CONST; }
"volatile"   { yylval.token_ptr = makeToken(yytext, "VOLATILE"); return VOLATILE; }
"if"         { yylval.token_ptr = makeToken(yytext, "IF"); return IF; }
"else"       { yylval.token_ptr = makeToken(yytext, "ELSE"); return ELSE; }
"for"        { yylval.token_ptr = makeToken(yytext, "FOR"); return FOR; }
"while"      { yylval.token_ptr = makeToken(yytext, "WHILE"); return WHILE; }
"do"         { yylval.token_ptr = makeToken(yytext, "DO"); return DO; }
"until"      { yylval.token_ptr = makeToken(yytext, "UNTIL"); return UNTIL; }
"switch"     { yylval.token_ptr = makeToken(yytext, "SWITCH"); return SWITCH; }
"case"       { yylval.token_ptr = makeToken(yytext, "CASE"); return CASE; }
"default"    { yylval.token_ptr = makeToken(yytext, "DEFAULT"); return DEFAULT; }
"break"      { yylval.token_ptr = makeToken(yytext, "BREAK"); return BREAK; }
"continue"   { yylval.token_ptr = makeToken(yytext, "CONTINUE"); return CONTINUE; }
"goto"       { yylval.token_ptr = makeToken(yytext, "GOTO"); return GOTO; }
"return"     { yylval.token_ptr = makeToken(yytext, "RETURN"); return RETURN; }
"printf"     { yylval.token_ptr = makeToken(yytext, "PRINTF"); return PRINTF; }
"scanf"      { yylval.token_ptr = makeToken(yytext, "SCANF"); return SCANF; }
"malloc"     { yylval.token_ptr = makeToken(yytext, "MALLOC"); return MALLOC; }
"free"       { yylval.token_ptr = makeToken(yytext, "FREE"); return FREE; }
"calloc"     { yylval.token_ptr = makeToken(yytext, "CALLOC"); return CALLOC; }
"realloc"    { yylval.token_ptr = makeToken(yytext, "REALLOC"); return REALLOC; }
"FILE"       { yylval.token_ptr = makeToken(yytext, "FILE"); return FILE_KW; }
"fopen"      { yylval.token_ptr = makeToken(yytext, "FOPEN"); return FOPEN; }
"fclose"     { yylval.token_ptr = makeToken(yytext, "FCLOSE"); return FCLOSE; }
"fread"      { yylval.token_ptr = makeToken(yytext, "FREAD"); return FREAD; }
"fwrite"     { yylval.token_ptr = makeToken(yytext, "FWRITE"); return FWRITE; }
"fprintf"    { yylval.token_ptr = makeToken(yytext, "FPRINTF"); return FPRINTF; }
"fscanf"     { yylval.token_ptr = makeToken(yytext, "FSCANF"); return FSCANF; }
"fgets"      { yylval.token_ptr = makeToken(yytext, "FGETS"); return FGETS; }
"fputs"      { yylval.token_ptr = makeToken(yytext, "FPUTS"); return FPUTS; }
"feof"       { yylval.token_ptr = makeToken(yytext, "FEOF"); return FEOF; }
"bool"       { yylval.token_ptr = makeToken(yytext, "BOOL"); return BOOL; }
"new"        { yylval.token_ptr = makeToken(yytext, "NEW"); return NEW; }
"delete"     { yylval.token_ptr = makeToken(yytext, "DELETE"); return DELETE; }
"sizeof"     { yylval.token_ptr = makeToken(yytext, "SIZEOF"); return SIZEOF; }

{ID}         { 
                 yylval.token_ptr = makeToken(yytext, "identifier"); 
                 SymbolEntry sym;
                 if (g_symTable.lookup(yytext, sym) && (sym.role == SymRole::CLASS_TAG || sym.role == SymRole::STRUCT_TAG || sym.role == SymRole::ENUM_TAG || sym.role == SymRole::TYPEDEF_NAME)) {
                     return TYPE_NAME;
                 }
                 return IDENTIFIER;
             }

\"                               { strbuf = "\""; tokStartLine = yylineno; litHadError = false; BEGIN(STRSTATE); }
<STRSTATE>\\[0-7]{1,3}           { strbuf += yytext; }
<STRSTATE>\\x{HEXDIGIT}+         { strbuf += yytext; }
<STRSTATE>\\[ntr\\'\"abfv?]      { strbuf += yytext; }
<STRSTATE>\\[^\n]                { reportError(yylineno, yytext, "Invalid escape sequence"); litHadError = true; strbuf += yytext; }
<STRSTATE>\"                     { strbuf += "\""; if (!litHadError) { yylval.token_ptr = makeToken(strbuf, "STRING_LITERAL"); BEGIN(INITIAL); return STRING_LITERAL; } BEGIN(INITIAL); }
<STRSTATE>\n                     { reportError(tokStartLine, strbuf, "Unterminated string literal"); BEGIN(INITIAL); }
<STRSTATE><<EOF>>                { reportError(tokStartLine, strbuf, "Unterminated string literal"); BEGIN(INITIAL); yyterminate(); }
<STRSTATE>.                      { strbuf += yytext; }

'                                { strbuf = "'"; tokStartLine = yylineno; litHadError = false; charCount = 0; BEGIN(CHRSTATE); }
<CHRSTATE>\\[ntr\\'\"abfv?]      { strbuf += yytext; charCount++; }
<CHRSTATE>\\x{HEXDIGIT}+         { strbuf += yytext; charCount++; }
<CHRSTATE>\\[0-7]{1,3}           { strbuf += yytext; charCount++; }
<CHRSTATE>\\[^\n]                { reportError(yylineno, yytext, "Invalid escape sequence"); litHadError = true; strbuf += yytext; charCount++; }
<CHRSTATE>'                      { 
                                     strbuf += "'"; 
                                     if (charCount > 1) {
                                         reportError(tokStartLine, strbuf, "Multi-character char literal");
                                     } else if (charCount == 0) {
                                         reportError(tokStartLine, strbuf, "Empty char literal");
                                     } else if (!litHadError) {
                                         yylval.token_ptr = makeToken(strbuf, "CHAR_LITERAL");
                                         BEGIN(INITIAL);
                                         return CHAR_LITERAL;
                                     }
                                     BEGIN(INITIAL); 
                                 }
<CHRSTATE>\n                     { reportError(tokStartLine, strbuf, "Unterminated character literal"); BEGIN(INITIAL); }
<CHRSTATE><<EOF>>                { reportError(tokStartLine, strbuf, "Unterminated character literal"); BEGIN(INITIAL); yyterminate(); }
<CHRSTATE>.                      { strbuf += yytext; charCount++; }

0[xX]{HEXDIGIT}+{INT_SUFFIX}?    { yylval.token_ptr = makeToken(yytext, "INT_LITERAL"); return INT_LITERAL; }
0[bB]{BINDIGIT}+{INT_SUFFIX}?    { yylval.token_ptr = makeToken(yytext, "INT_LITERAL"); return INT_LITERAL; }
0{OCTDIGIT}+{INT_SUFFIX}?        { yylval.token_ptr = makeToken(yytext, "INT_LITERAL"); return INT_LITERAL; }
{FRAC}([eE][+-]?{DIGIT}+)?[fF]?  { yylval.token_ptr = makeToken(yytext, "FLOAT_LITERAL"); return FLOAT_LITERAL; }
{DIGIT}+[eE][+-]?{DIGIT}+[fF]?   { yylval.token_ptr = makeToken(yytext, "FLOAT_LITERAL"); return FLOAT_LITERAL; }
{DIGIT}+{INT_SUFFIX}?            { yylval.token_ptr = makeToken(yytext, "INT_LITERAL"); return INT_LITERAL; }
"true"|"false"                   { yylval.token_ptr = makeToken(yytext, "BOOL_LITERAL"); return BOOL_LITERAL; }

"..." { yylval.token_ptr = makeToken(yytext, "ELLIPSIS"); return ELLIPSIS; }
"::"  { yylval.token_ptr = makeToken(yytext, "SCOPE_RES"); return SCOPE_RES; }
"->"  { yylval.token_ptr = makeToken(yytext, "ARROW"); return ARROW; }
"++"  { yylval.token_ptr = makeToken(yytext, "INC"); return INC; }
"--"  { yylval.token_ptr = makeToken(yytext, "DEC"); return DEC; }
"<<=" { yylval.token_ptr = makeToken(yytext, "SHL_ASSIGN"); return SHL_ASSIGN; }
">>=" { yylval.token_ptr = makeToken(yytext, "SHR_ASSIGN"); return SHR_ASSIGN; }
"<<"  { yylval.token_ptr = makeToken(yytext, "SHL"); return SHL; }
">>"  { yylval.token_ptr = makeToken(yytext, "SHR"); return SHR; }
"<="  { yylval.token_ptr = makeToken(yytext, "LE_OP"); return LE_OP; }
">="  { yylval.token_ptr = makeToken(yytext, "GE_OP"); return GE_OP; }
"=="  { yylval.token_ptr = makeToken(yytext, "EQ_OP"); return EQ_OP; }
"!="  { yylval.token_ptr = makeToken(yytext, "NE_OP"); return NE_OP; }
"&&"  { yylval.token_ptr = makeToken(yytext, "AND_OP"); return AND_OP; }
"||"  { yylval.token_ptr = makeToken(yytext, "OR_OP"); return OR_OP; }
"+="  { yylval.token_ptr = makeToken(yytext, "PLUS_ASSIGN"); return PLUS_ASSIGN; }
"-="  { yylval.token_ptr = makeToken(yytext, "MINUS_ASSIGN"); return MINUS_ASSIGN; }
"*="  { yylval.token_ptr = makeToken(yytext, "MUL_ASSIGN"); return MUL_ASSIGN; }
"/="  { yylval.token_ptr = makeToken(yytext, "DIV_ASSIGN"); return DIV_ASSIGN; }
"%="  { yylval.token_ptr = makeToken(yytext, "MOD_ASSIGN"); return MOD_ASSIGN; }
"&="  { yylval.token_ptr = makeToken(yytext, "AND_ASSIGN"); return AND_ASSIGN; }
"|="  { yylval.token_ptr = makeToken(yytext, "OR_ASSIGN"); return OR_ASSIGN; }
"^="  { yylval.token_ptr = makeToken(yytext, "XOR_ASSIGN"); return XOR_ASSIGN; }

[+\-*/%=<>!&|^~.,?:(){}\[\]\;]   { 
                                     yylval.token_ptr = makeToken(yytext, yytext); 
                                     return yytext[0]; 
                                 }

.                                { reportError(yylineno, yytext, "Illegal character"); }

%%
